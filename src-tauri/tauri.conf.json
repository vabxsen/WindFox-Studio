{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WindFox Studio",
  "version": "0.1.0",
  "identifier": "com.windfox.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "WindFox Studio",
        "width": 1280,
        "height": 820,
        "minWidth": 500,
        "minHeight": 500,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "windowEffects": {
          "effects": ["mica"]
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "WindFox Studio",
    "shortDescription": "Set up a Windows 11 PC in one go",
    "longDescription": "Pick the apps you want and install them in one go, and keep drivers current with Windows Update.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}
